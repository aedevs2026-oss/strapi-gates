{
  "kind": "collectionType",
  "collectionName": "teachers",
  "info": {
    "singularName": "teacher",
    "pluralName": "teachers",
    "displayName": "Teacher",
    "description": "School teaching staff"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "employeeId": {
      "type": "string",
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "mobile": {
      "type": "string",
      "unique": true
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "enumeration",
      "enum": ["class_incharge", "subject_teacher", "both"],
      "default": "subject_teacher"
    },
    "teacherStatus": {
      "type": "enumeration",
      "enum": ["active", "inactive", "on_leave"],
      "default": "active",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "qualification": {
      "type": "string"
    },
    "lastLoginAt": {
      "type": "datetime"
    },
    "deviceToken": {
      "type": "string"
    },
    "subjects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::subject.subject",
      "inversedBy": "teachers"
    },
    "inchargeClasses": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::class.class",
      "mappedBy": "classIncharges"
    },
    "classesAsTeacher": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::class.class",
      "mappedBy": "classTeacher"
    },
    "teacherAssignments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::teacher-assignment.teacher-assignment",
      "mappedBy": "teacher"
    },
    "homeworks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::homework.homework",
      "mappedBy": "teacher"
    },
    "assignments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::assignment.assignment",
      "mappedBy": "teacher"
    },
    "timetables": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::timetable.timetable",
      "mappedBy": "teacher"
    }
  }
}
