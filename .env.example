# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Strapi Secrets (generate unique values for production)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Parent Mobile JWT
PARENT_JWT_SECRET=change-this-parent-jwt-secret-in-production
PARENT_JWT_EXPIRES_IN=30d

# Teacher Mobile JWT
TEACHER_JWT_SECRET=change-this-teacher-jwt-secret-in-production
TEACHER_JWT_EXPIRES_IN=30d

# Database (PostgreSQL)
DATABASE_CLIENT=mysql
DATABASE_HOST=sakura.proxy.rlwy.net
DATABASE_PORT=37970
DATABASE_NAME=goldengates
DATABASE_USERNAME=root
DATABASE_PASSWORD=pfiWgwuAahKTKcTSbwSGAAkquEtuClGl
DATABASE_SSL=false
DATABASE_SCHEMA=public

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_DEV_MODE=false

# WhatsApp plugin (built into Strapi — Admin → WhatsApp to scan QR)
WHFLOW_ENABLED=true
WHATSAPP_AUTH_PATH=.wwebjs_auth
# Optional: override browser path (Render/Linux usually auto-detected after postinstall)
# CHROME_PATH=/usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/opt/render/.cache/puppeteer/chrome/linux-*/chrome-linux64/chrome
SCHOOL_NAME=Gates International School

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5
OTP_VERIFY_RATE_LIMIT_MAX=10

# Debug (development only — never enable in production)
DEBUG_PARENT_API=false

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# CORS (comma-separated origins for React Native / web)
CORS_ORIGINS=*

# Upload limits
UPLOAD_MAX_FILE_SIZE=10485760
